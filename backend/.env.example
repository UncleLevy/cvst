# Copy to backend/.env and edit. Never commit the real .env file.

DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Leave DB_NAME unset to use SQLite (zero setup).
# To use PostgreSQL (see docker-compose.yml), uncomment:
# DB_NAME=cvst_db
# DB_USER=cvst_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# How scans run: thread = inside Django, no Redis/worker needed (default);
# celery = queued to a worker (needs Redis and `celery -A config worker`).
CVST_SCAN_RUNNER=thread

# Celery / Redis (only used when CVST_SCAN_RUNNER=celery)
CELERY_BROKER_URL=redis://localhost:6379/0
# Run scans inline with no Redis or worker (blocks the request, dev only):
CELERY_TASK_ALWAYS_EAGER=False

# True = real scans (Nmap for network, HTTP checks for web; needs the nmap binary
# for network scans). False = simulated, clearly-labelled demo findings.
# Only scan systems you are authorised to test.
CVST_REAL_SCANS=True
# Allow scanning 127.0.0.1/localhost (off by default so a scan cannot reach the CVST server itself).
CVST_ALLOW_LOOPBACK_TARGETS=False

# NVD lookups (CVE enrichment + version matching). Key is optional but raises the rate limit.
CVST_NVD_LOOKUP=True
NVD_API_KEY=

# Public self-registration (off by default; use `createsuperuser` or /admin).
CVST_ALLOW_REGISTRATION=False
